	(text "MMU2"
		(exclude_from_sim no)
		(at 97.79 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "917b40c1-a529-41f6-9acf-de6667bad176")
	)
	(text "Second byte of segment index.\nUses aligned load/store word *shifted left by one* instead of load/store byte for value of PMAP index\nD16 is not actually stored or used, so only the upper 15 bits of the word are meaningful.\n\nPLEASE NOTE:\nThe MMU bus is only wired for 8 bits not matter what; the design of the 3/60 rely on the MC68020 bus sizing properties to work.\nFor instance, when doing a LONG access to the PMAP, the 3/60 only ackonwledge a BYTE, and write the upper bits to PMAP0.\nThen the MC68020 do more bus cycles for the other bytes, increasing the address, to which the 3/60 reacts by enablig PMAP1 (unimplemented), PMAP2 and PMAP3\n\n\nThis uses the same technique to update the SMAP, by expanding SMAP to SMAP+SMAP1"
		(exclude_from_sim no)
		(at 164.592 146.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "96e76211-319c-450e-b17f-8d281d7866b5")
	)
	(text "BERR REGISTER"
		(exclude_from_sim no)
		(at 143.51 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "9ef822a0-7ccd-4da8-b6b4-ab773e9d2085")
	)
	(text "CONTEXT\n(cx3 added with pull-down)"
		(exclude_from_sim no)
		(at 87.63 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a8a1d9f6-0315-4bc6-a3a9-20916792fff9")
	)
	(text "MMU0"
		(exclude_from_sim no)
		(at 26.67 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "aa47f3a8-d3f6-49b5-837e-56a3a8bcd792")
	)
	(text "Controls for additional input signals.\nS3E_* are 'filtered' version of the normal signal.\nWhen ENABLE_S3E is unwanted, then the additional chips are always disabled and all additional address lines to the PMAP and SPMAP SRAMs are zero.\nWhen ENABLE_S3E is wanted, the additional chips track the behavior of those they extend.\n\nexnteded virtual memory (ENABLE_S3E is handled separately to ease debug), as those trea 2 bits also required aliased PMAP to work."
		(exclude_from_sim no)
		(at 13.716 -130.302 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "abd5f72a-d53d-4689-9cc4-e68af989c012")
	)
	(text "SEGMENT MAP"
		(exclude_from_sim no)
		(at 137.16 -97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cf468791-5ecb-470c-9155-034e1bdbe5e0")
	)
	(text "U231 needs a bigger PAL (or two PALs)\n(a) it needs to output EN.SMAP1- & WE.SMAP1-\n\nWE_SMAP	 = (            !A28 &  A29 & !A30 & EN_CTL & WRITE & C_S3         & !C_S7X);\nEN_SMAP	 = (            !A28 &  A29 & !A30 & EN_CTL                & C_S5);\n(which ignore alignement) should become\n\n/* byte or upper byte of word */\nWE_SMAP	 = (!A1 & !A0 & !A28 &  A29 & !A30 & EN_CTL & WRITE & C_S3         & !C_S7X);\nEN_SMAP	 = (!A1 & !A0 & !A28 &  A29 & !A30 & EN_CTL                & C_S5);\n/* lower byte of word */\nWE_SMAP1 = (!A1 &  A0 & !A28 &  A29 & !A30 & EN_CTL & WRITE & C_S3         & !C_S7X);\nEN_SMAP1 = (!A1 &  A0 & !A28 &  A29 & !A30 & EN_CTL                & C_S5);\n\n=> this permit to use the extended S[25..31] bits to address more PMAP\n\n(b) it needs access to A31 to alias the SMAP from 0x2 in Control Space to 0x9, oxC and OxD:\n\n/* byte or upper byte of word */\nwe_smap_0x2	 = (!A1 & !A0 & !A28 &  A29 & !A30 & !A31 & EN_CTL & WRITE & C_S3         & !C_S7X);\nwe_smap_0x9	 = (!A1 & !A0 &  A28 & !A29 & !A30 &  A31 & EN_CTL & WRITE & C_S3         & !C_S7X);\nwe_smap_0xc	 = (!A1 & !A0 & !A28 & !A29 &  A30 &  A31 & EN_CTL & WRITE & C_S3         & !C_S7X);\nwe_smap_0xd	 = (!A1 & !A0 &  A28 & !A29 &  A30 &  A31 & EN_CTL & WRITE & C_S3         & !C_S7X);\nWE_SMAP  = we_smap_0x2 | we_smap_0x9 | we_smap_0xc | we_smap_0xd\n\n/* same changes for EN_SMAP, WE_SMAP1, EN_SMAP1 */\n\n=> this also permit to use another 768 MiB of virtual space\n\n(c) it would make sense to also generate EN.PMAP1 and WE.PMAP1 (similar to the other three but with !A1 &  A0) to support the third bytes of PMAP and the missing PA (PA29 to PA31 architecturally, up to PA36 practically)"
		(exclude_from_sim no)
		(at -83.058 153.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d901f0e3-1e60-4788-9cff-bcc7630bed39")
	)
