	(text "CONTEXT (upper nybble)\nContext register is accessed normally (byte), just with a different mask\nNormal Sun3 is CtxId & 0x7 (3 bits)\nExtended Sun3 is CtxId & 0x3f (6 bits)\nSo we get 64 hardware contexts"
		(exclude_from_sim no)
		(at 23.368 -37.592 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e9aaee55-fe14-45ca-a1b0-28e7597414b8")
	)
