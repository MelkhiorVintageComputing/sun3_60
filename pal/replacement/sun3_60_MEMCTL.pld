/* INPUTS */
/* U803 */
PIN 87 = CLK; /* on a CLK pin, but we use it as a regular I/O */
PIN 6 = !DIS_RAS;
PIN 8 = AS; /* we could use the active-low version instead */
PIN 9 = !C_S3;
PIN 10 = C_S5; /* originally into U108D */
PIN 13 = !IN_RAS; /* feedback originally from U104E */
/* U804 */
/* CLK */
PIN 14 = EN_CAS;
/* C.S3 */
PIN 16 = !DISACC;
PIN 17 = !RACK; /* originally inverted by U108C */
/* CLK-, AS */
PIN 19 = !IN_CAS; /* feedback originally from U104F */
/* U801 */
PIN 20 = A2;
PIN 21 = PA22;
/* !TWOWAY becomes internal */
/* U800 */
PIN 23 = SIZ0;
PIN 25 = SIZ1;
PIN 29 = A0;
PIN 30 = A1;
/* !SEL0, SEL1 become internal */
PIN 31 = !WRITE;
/* RACK */
/* U802 */
PIN 32 = !M_PD;
PIN 33 = !M_S0;
PIN 35 = !M_S1;
PIN 36 = !M_S2;
PIN 37 = !M_S3;
PIN 40 = !M_S4;
PIN 41 = !M_S5;
/* PA02_22 becomes internal */
PIN 44 = PA23;
PIN 45 = PA24;
PIN 46 = PA25;
PIN 47 = PA26;
PIN 48 = PA27;
/* R_ACK, M_PD */
/* U805 */
/* !CE, !CAS, !C_S3, !M_PD */
PIN 52 = !V_INTY;
PIN 54 = !V_INTX;
PIN 56 = !INIT;
PIN 57 = !R_ACK;
PIN 58 = f13;
/* OUTPUTS */
/* U803 */
PIN 60 = !RAS;
/* U804 */
PIN 61 = !CAS;
/* U801 */
/* PA02_22 becomes internal (PA22_O2 isn't as it's used by U906,
   one of the address multiplexers for the DRAM ) */
PIN 63 = PA22_02;
/* !SEL0, SEL1 become internal */
/* U800 */
PIN 64 = !RE00;
PIN 65 = !RE01;
PIN 67 = !RE02;
PIN 68 = !RE03;
PIN 69 = !RE10;
PIN 71 = !RE11;
PIN 75 = !RE12;
PIN 76 = !RE13;
/* U802 */
PIN 79 = !CAS0;
PIN 80 = !CAS1;
PIN 81 = !CAS2;
PIN 83 = !CAS3;
PIN 84 = !CAS4;
PIN 92 = !CAS5;
/* TWOWAY becomes internal */
/* !CE becomes internal */
/* U805 */
PIN 93 = DSACK0n;
PIN 94 = DSACK1n;
PIN 96 = DXACK;
PIN 97 = !V_INT;
/*
PIN 98 = ;
PIN 99 = ;
PIN 100 = ;
*/
/* Note that XXX and YYY are active-low signals but we do NOT declare them
inverted here, as the ATF1502 fitter seems to ignore output enables on pins that
are declared inverted */

/*
RESERVED
PIN 4   = TDI ;
PIN 15  = TMS ;
PIN 62  = TCK ;
PIN 73  = TDO ;
*/

/* U803, 74F64 */
/* RAS activation
   (it will be combined with RE[01][0123] later through an OR gate to generate the actual RAS for the different SIMMs)
   If I get that correctly:
   First term:
     Enable RAS during a high clock cycle when /AS is activated and C_S3 isn't
     => To me from the MC68020 documentation, this means during S2; then during S3, C_S3 becomes active and prevent this term from activating RAS
     DIS_RAS prevent RAS to be activated (generated by U102 / FCDECODE, handle CPU Space FC=0x7)
   Second term:
     Holding term; if activated, RAS is kept activated as long as C_S5 is not activated or CLK is low.
     => To me, as C_S5 is a "clock low" state, this means until the clock rising edge between S5 and S6, so during S6
   So for normal memory cycle, RAS is activated from S2 to S6, or for about 2 cycles @ 20 MHz or about 100ns (modulo the various delays...)
*/
RAS = (CLK & !DIS_RAS & AS & !C_S3) #
      (!(CLK & C_S5) & IN_RAS);  /* merge U108D, U104E */

/* U804, 74F64 */
/* CAS activation
   (it will be combined with CAS[0..5] later through an OR gate to generate the actual CAS for the different SIMMs)
   If I get that correctly:
   First term:
     Enable CAS during a high clock cycle when C_S3 is activated, which is the transition between S3 and S4 (so during S4)
     Prevent enablement if EN_CAS is not actiavated, or DISACC is activated
       EN_CAS is enabled when accessing something other than Type 0 device address space
       (so TYPE[01] != 0x0, EN_DEV activated, or PA28 set indicating a prefix of 0xF so out of main memory such as a VRAM framebuffer)
   Second Term:
     R_ACK is a for refresh; enable CAS as soon as that happens, presumably for a CAS-before-RAS refresh cycle
   Third term:
     Holding term; keeps CAS activated during clock cycle low
   Fourth term:
     Holding term; keeps CAS activated as long as AS is active
   So for normal memory cycle, CAS is activated from S4 to clock cycle high during/after the deactivation of AS,
   so starts 1 cycle @ 20 MHz or about 50ns after RAS.
   For deactivation, it likely depends on when AS is deactivated. The MC68020 reacts to DSACK[01] being asserted which
   happens in U805 (1590-01) as soon as CAS, CE and C.S3 are all active. 
*/

CAS = (CLK & EN_CAS & C_S3 & !DISACC) #
      R_ACK #                    /* merge U108C */
      (!CLK & IN_CAS) #          /* merge U104F */
      (AS & IN_CAS);             /* merge U104F */

/* U801, 74AS257 */
/* Uses TWOWAY to pick between A2 and PA22,
   and to generate SEL0/SEL1 (both active when TWOWAY is inactive) */
PA02_22 = ( TWOWAY &   A2) #
	  (!TWOWAY & PA22);
PA22_02 = ( TWOWAY & PA22) #
          (!TWOWAY &   A2);
SEL0 = !(( TWOWAY & A2) #
         (!TWOWAY & 'b'0)); /* for symmetry */
SEL1 =  (( TWOWAY & A2) #
         (!TWOWAY & 'b'1));

/* U800 */
/*
   A0, A1, SIZ0, SIZ1 testing is standard "do we use this byte" 68k bus stuff, used for writing.
   (if !WRITE, then all bytes are activated based on SEL0/SEL1).
   First term for writing:; each byte is active if their address is accessed directly (REx3 is the lowest address and therefore the MSB in big-endian, 'first byte')
   Second term: the second byte is active if word or longword (!SIZ0) in the first half of the addressed longword (!A1, offset 0x0 or 0x1)
                the third  byte is active if word or 3bytes (SIZ1) at offset 0x1 (A0 & !A1)
		the fourth byte is active if word or 3bytes (SIZ1) at offset 0x2 or 0x3 (A1)
   Third term: the second byte is active if word or 3bytes (SIZ1) in the first half of the longword (!A1, offset 0x0 or 0x1)
   	       the third  byte is active if longword (!SIZ0 & !SIZ1) in the first half of the longword (!A1, offset 0x0 or 0x1)
	       the fourth byte is active if longword (!SIZ0 & !SIZ1)
   Fourth term: the third  byte is active if 3bytes (SIZ0 & SIZ1) in the first half of the longword (!A1, offset 0x0 or 0x1)
   	  	the fourth byte is active if 3bytes (SIZ0 & SIZ1) on odd-numbered addresses (A0, offset 0x1 or 0x3)
   This is straight from Table 9-1 and Figure 9-6 from the MC68020 documentation, with added SEL0/SEL1 (REx3 <> UUDA, REx2 <> UMDA, REx1 <> LMDA, REx0 <> LLDA).

   SEL0/SEL1 is picking between the two banks of DRAM when TWOWAY is active (those two banks are interleaved at the doubleword level, by A2).
   if TWOWAY is inactive, then both banks in each of the three pairs are activated by RAS, but one of them would not receive CAS... which would cause a refresh cycle ?!?
   The 3/60 manual shows a bank of jumper, and it seems all multiple of 4 MiB from 4 to 24 are supported...

   R_ACK is for refresh cycle and is generated by the DVMA.

   ** note **
   The fact the byte-selection stuff is on RAS is a 3/60 quirk; later DRAM chips/SIMMs wider than 8 bits expect the byte selection to be done with CAS instead.
   Unfortunately, it means as defined the 3/60 hardware won't take wider memory easily.
   The RAS/CAS need to be reworked to that the byte selection is on CAS.
   To avoid too many CAS lines, the bank selection (done below via CAS[0.5]) would need to be moved in RAS.

*/
RE00	= (R_ACK # (SEL0 & !WRITE) # ( A0 &  A1 & SEL0) # (       SIZ1      &  A1 & SEL0) # (!SIZ1 & !SIZ0       & SEL0) # (SIZ1 & SIZ0 & A0       & SEL0));
RE01	= (R_ACK # (SEL0 & !WRITE) # (!A0 &  A1 & SEL0) # (       SIZ1 & A0 & !A1 & SEL0) # (!SIZ1 & !SIZ0 & !A1 & SEL0) # (SIZ1 & SIZ0      & !A1 & SEL0));
RE02	= (R_ACK # (SEL0 & !WRITE) # ( A0 & !A1 & SEL0) # (!SIZ0            & !A1 & SEL0) # ( SIZ1         & !A1 & SEL0));
RE03	= (R_ACK # (SEL0 & !WRITE) # (!A0 & !A1 & SEL0));
RE10	= (R_ACK # (SEL1 & !WRITE) # ( A0 &  A1 & SEL1) # (       SIZ1      &  A1 & SEL1) # (!SIZ1 & !SIZ0       & SEL1) # (SIZ1 & SIZ0 & A0       & SEL1));
RE11	= (R_ACK # (SEL1 & !WRITE) # (!A0 &  A1 & SEL1) # (       SIZ1 & A0 & !A1 & SEL1) # (!SIZ1 & !SIZ0 & !A1 & SEL1) # (SIZ1 & SIZ0      & !A1 & SEL1));
RE12	= (R_ACK # (SEL1 & !WRITE) # ( A0 & !A1 & SEL1) # (!SIZ0            & !A1 & SEL1) # ( SIZ1 &         !A1 & SEL1));
RE13	= (R_ACK # (SEL1 & !WRITE) # (!A0 & !A1 & SEL1));

/* not needed, might mess with negative-logic... */
/*
RE00_oe = M_PD;
RE01_oe = M_PD;
RE02_oe = M_PD;
RE03_oe = M_PD;
RE10_oe = M_PD;
RE11_oe = M_PD;
RE12_oe = M_PD;
RE13_oe = M_PD;
*/

/* U802 */
/*
   Trival address-based CAS selector for the 6 banks.
   PA[25..27] must be zero, limiting the maximum addressable memory
   PA[22..24] defines the eight possible banks of 4 MiB each, so max 32 MiB
   Only six are actually available, so PA24=1 & PA23=1 goes unused.
   When TWOWAY is active, A02 is used instead of PA22.

   M_S[0..5] are "presence" signals from the six banks. M_S[0] is hardwired active.
   The other 5 are optional and must architecturally be filled in order
   (the sun3 architecture requires the physical memory to be contiguous, see the S3AMv3)
   TWOWAY checks whether only pairs are filled (0&1, 0&1&2&3, 0&1&2&3&4&5)
   
   R_ACK is for refresh cycle and is generated by the DVMA.

   CE is basically whether any of the CAS[0..5] is enabled (same equations or'ed).
*/
CAS0	= (R_ACK # (M_S0 & !PA02_22 & !PA23 & !PA24 & !PA25 & !PA26 & !PA27));
CAS1	= (R_ACK # (M_S1 &  PA02_22 & !PA23 & !PA24 & !PA25 & !PA26 & !PA27));
CAS2	= (R_ACK # (M_S2 & !PA02_22 &  PA23 & !PA24 & !PA25 & !PA26 & !PA27));
CAS3	= (R_ACK # (M_S3 &  PA02_22 &  PA23 & !PA24 & !PA25 & !PA26 & !PA27));
CAS4	= (R_ACK # (M_S4 & !PA02_22 & !PA23 &  PA24 & !PA25 & !PA26 & !PA27));
CAS5	= (R_ACK # (M_S5 &  PA02_22 & !PA23 &  PA24 & !PA25 & !PA26 & !PA27));

CE	= (R_ACK # (M_S0 & !PA02_22 & !PA23 & !PA24 & !PA25 & !PA26 & !PA27) #
	  	   (M_S1 &  PA02_22 & !PA23 & !PA24 & !PA25 & !PA26 & !PA27) #
          	   (M_S2 & !PA02_22 &  PA23 & !PA24 & !PA25 & !PA26 & !PA27) #
	  	   (M_S3 &  PA02_22 &  PA23 & !PA24 & !PA25 & !PA26 & !PA27) #
	  	   (M_S4 & !PA02_22 & !PA23 &  PA24 & !PA25 & !PA26 & !PA27) #
          	 (  M_S5 &  PA02_22 & !PA23 &  PA24 & !PA25 & !PA26 & !PA27));
		 
TWOWAY	= ((M_S1 & M_S0 &  M_S2 &  M_S3 &  M_S4 &  M_S5) #
	   (M_S1 & M_S0 &  M_S2 &  M_S3 & !M_S4 & !M_S5) #
	   (M_S1 & M_S0 & !M_S2 & !M_S3 & !M_S4 & !M_S5));


/* not needed, might mess with negative-logic... */
/*
CAS0_oe = M_PD;
CAS1_oe = M_PD;
CAS2_oe = M_PD;
CAS3_oe = M_PD;
CAS4_oe = M_PD;
CAS5_oe = M_PD;
TWOWAY_oe = M_PD;
CE_oe = M_PD;
*/


/* U805 */
DSACK0n	=   !(CAS & CE & C_S3);
DSACK1n	=   !(CAS & CE & C_S3);
DSACK0n.oe = (CAS & CE & C_S3);
DSACK1n.oe = (CAS & CE & C_S3);

/* that could seem redundant, but isn't.
   DXACK is always friven (no .oe!)
   If (CAS & CE & C_S3) is active, then all three signals (DSACK[0..1] and DXACK are activated and DSACK[01] are driven.
   If (CAS & CE & C_S3) is not active, then DSACK[0..1] are *inputs* and DXACK tracks them (when something other than memory is acknowledging the transaction)
*/

DXACK	= (!DSACK0n #
           !DSACK1n #
	   (CAS & CE & C_S3));

/* V_INT is the video interrupt (to the interrupt controller
   V_INTX is from the builtin video, and V_INTY from the P4
   Presumably, the P4 has priority, so when this see a V_INTY
   (and set f13) out of INIT this becomes the interrupt for
   the V_INT, otherwise V_INTX is used.
*/

/* ***** WARNING ***** */
/* The 'hold' syntax from the PAL code isn't valid PLD! */
/* Intermediate can't depend on itself! */
/* f13 must have pins for this to compile with WinCUPL */
/* ***** WARNING ***** */

  
f13	= (f13    & !INIT) #
          (V_INTY & !INIT);
V_INT	= (V_INTY &  f13) #
          (V_INTX & !f13);
/* not needed, might mess with negative-logic... */
/* f13 not actually used externally */
/*
DXACK.oe = M_PD;
V_INT.oe = M_PD
*/

